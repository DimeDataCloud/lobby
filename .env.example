# Copy to .env beside docker-compose.yml. Every other setting is fixed in the
# compose file; these are the ones that differ per deployment.

# Required. The origin people open, e.g. https://lobby.example.com. OAuth
# redirect URIs and the WebSocket origin check are both built from it.
PUBLIC_ORIGIN=
PRODUCT_NAME=Lobby

# Sign-in. Configure at least one before selling seats; with none, invite
# codes still work. Callbacks: $PUBLIC_ORIGIN/auth/github/callback and
# $PUBLIC_ORIGIN/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emailed sign-in links. One provider key plus MAIL_FROM.
SMTP2GO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Lobby

# Operator-only backup status at /admin/backups. Unset = the route 404s.
ADMIN_KEY=

# Optional overrides (compose defaults shown)
# BACKUP_KEEP=14
# BACKUP_INTERVAL_MS=21600000
# AUDIT_RETENTION_DAYS=365
# EVENT_RETENTION_DAYS=90
